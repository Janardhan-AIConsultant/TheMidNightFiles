APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=the-midnight-files

DATABASE_URL=sqlite:///./data/substack_automation.db
DATA_DIR=./data
LOG_DIR=./logs

CACHE_ENABLED=true
CACHE_BACKEND=filesystem
CACHE_DIRECTORY=./data/cache
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_LLM_TTL_SECONDS=604800
CACHE_IMAGE_TTL_SECONDS=2592000
CACHE_API_TTL_SECONDS=300
CACHE_MAX_SIZE_MB=1024
CACHE_CLEANUP_INTERVAL_HOURS=24
CACHE_LOCK_TIMEOUT_SECONDS=120
CACHE_LOCK_STALE_SECONDS=300
CACHE_FAIL_OPEN=true
# Only when CACHE_BACKEND=redis (not implemented yet)
REDIS_URL=

# Conservative fallbacks for models missing from the registry (unverified assumptions)
DEFAULT_CONTEXT_LIMIT=8192
DEFAULT_MAX_OUTPUT=2048
# Optional JSON file listing verified models (provider, model_id, context_limit, max_output, tools, structured, pricing)
MODEL_REGISTRY_FILE=

VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_REVISION_ATTEMPTS=3
PUBLISHING_MAX_RETRIES=3

# Rotating log files (written under LOG_DIR; logs are files only, never DB tables)
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Optional image generation hook: "package.module:callable".
# The callable is invoked as callable(asset_spec: dict, story_id: str, version: int) and must return a stored
# asset reference (str). NO real image backend is bundled. When empty, the Image agent only produces prompts and
# the workflow's readiness gate reports "no validated image assets" until you configure a tool.
IMAGE_GENERATOR=

# Secrets live ONLY in .env / the environment (never commit .env). /settings only reports configured yes/no.
